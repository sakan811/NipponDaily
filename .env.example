# Upstash Redis — stores the site's season (optional; held in memory without it)
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Season cron (server/api/cron/update-season.get.ts) — Vercel sends it as a
# bearer token. Generate with: openssl rand -hex 32
CRON_SECRET="your_long_random_cron_secret_here"

# The site's public origin, e.g. https://nippondaily.example — used for canonical
# and Open Graph URLs and the sitemap. Optional: without it, each request's own
# origin is used.
NUXT_PUBLIC_SITE_URL=""

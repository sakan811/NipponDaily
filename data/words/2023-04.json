  {
    "date": "2023-04-06",
    "term": "馬鹿",
    "kana": "ばか",
    "meaning": "fool, idiot",
    "level": "N3",
    "pos": ["noun (common) (futsuumeishi)"],
    "priority": ["ichi1", "news2", "nf45", "spec1"],
    "stratum": "hybrid",
    "processes": ["compound", "ateji"],
    "headline": "“Fool” is spelled “horse + deer”, but those characters were fitted to the sound — probably an allusion to an old Chinese saying.",
    "morphemes": [
      {
        "text": "馬",
        "reading": "ば",
        "meaning": "horse"
      },
      {
        "text": "鹿",
        "reading": "か",
        "meaning": "deer"
      }
    ],
    "sources": [
      {
        "quote": "Probably originally a transcription of Sanskrit मोह (moha, “folly”), used as a cant term among monks. However, Sanskrit पाक (pāka, “naïve, foolish”) is more similar phonetically and grammatically."
      },
      {
        "quote": "Alternatively, may have arisen from the same root as Old Japanese 痴 (woko, modern oko, “stupidity, ridiculousness”). However, this theory is problematic phonologically, as the /b/ ↔ /w/ shift is difficult to explain."
      },
      {
        "quote": "The characters 馬鹿 (literally “horse + deer”) are ateji (当(あ)て字(じ)), probably chosen as an allusion to Literary Chinese 指鹿為馬 (“to deliberately misinterpret and invert right and wrong”, literally “to point to a deer and call it a horse”) (see that entry for more)."
      }
    ],
    "examples": [
      {
        "id": 111310,
        "ja": "彼はばかだ。",
        "en": "He is foolish.",
        "enId": 292373,
        "form": "ばか",
        "furigana": [["彼", "かれ"], ["はばかだ。"]]
      },
      {
        "id": 111304,
        "ja": "彼はばか丁寧だ。",
        "en": "He is polite to a fault.",
        "enId": 292378,
        "form": "ばか",
        "furigana": [["彼", "かれ"], ["はばか"], ["丁寧", "ていねい"], ["だ。"]]
      }
    ],
    "wiktionaryDump": "2026-09-02"
  },

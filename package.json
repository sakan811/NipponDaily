{
  "name": "nippondaily",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "HOST=127.0.0.1 node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint . --fix",
    "format": "pnpm exec prettier . --write",
    "type-check": "tsc --noEmit",
    "check-qa": "pnpm lint && pnpm format && pnpm type-check && pnpm build && pnpm test:run",
    "data:reference": "node --experimental-strip-types --no-warnings scripts/build-n5-reference.mjs",
    "data:reference:jlpt": "node --experimental-strip-types --no-warnings scripts/build-jlpt-reference.mjs",
    "data:words": "node scripts/generate-word-entries.mjs",
    "data:kanji": "node --experimental-strip-types --no-warnings scripts/build-kanji-reference.mjs",
    "data:etymology": "node scripts/build-etymology-reference.mjs",
    "data:strokes": "node --experimental-strip-types --no-warnings scripts/build-strokes-reference.mjs",
    "data:pitch": "node --experimental-strip-types --no-warnings scripts/build-pitch-reference.mjs",
    "data:sentences": "node scripts/build-sentences-reference.mjs",
    "assets:og-font": "node scripts/build-og-font.mjs",
    "docs:sync": "node --experimental-strip-types --no-warnings scripts/sync-docs.mjs",
    "docs:check": "node --experimental-strip-types --no-warnings scripts/sync-docs.mjs --check"
  },
  "dependencies": {
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@upstash/redis": "^1.39.0",
    "nuxt": "^4.5.2",
    "satori": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "wanakana": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "h3": "^1.15.11",
    "happy-dom": "^20.14.5",
    "kuromoji": "0.1.2",
    "lindera-wasm-nodejs-unidic": "2.0.0",
    "opentype.js": "^2.0.0",
    "prettier": "3.9.9",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}

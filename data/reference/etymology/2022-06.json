 "酔う": {
  "url": "https://en.wiktionary.org/wiki/%E9%85%94%E3%81%86",
  "etymologies": [
   {
    "heading": "Etymology",
    "text": "/wepu/ → /wefu/ → /jefu/ → */jewu/ → */jowu/ → /jou/\nShift from classical verb 酔ふ (efu → eu), possibly parsed as jefu, itself from Old Japanese 酔ふ (wepu → wefu → eu).\nCompare the development of 葉 (efu → yō, “leaf”, on-yomi or Chinese-derived reading).",
    "readings": [
     "よう"
    ]
   },
   {
    "heading": "Etymology",
    "text": "Regular development of wepu. In the colloquial language, wepu developed into you, so eu is now only used in reading ancient texts.",
    "readings": [
     "えう"
    ]
   }
  ]
 },

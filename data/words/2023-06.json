  {
    "date": "2023-06-12",
    "term": "哲学",
    "kana": "てつがく",
    "meaning": "philosophy",
    "level": "N3",
    "pos": ["noun (common) (futsuumeishi)"],
    "priority": ["ichi1", "news1", "nf05"],
    "pitch": [2, 0],
    "stratum": "kango",
    "processes": ["compound"],
    "headline": "Nishi Amane coined “philosophy” in 1874 — after first trying a spelling that copies the Greek.",
    "morphemes": [
      {
        "text": "哲",
        "reading": "てつ",
        "meaning": "clear, wise, sage"
      },
      {
        "text": "学",
        "reading": "がく",
        "meaning": "study"
      }
    ],
    "sources": [
      {
        "quote": "By surface analysis, 哲(てつ) (tetsu, “clear, wise, sage”) + 学(がく) (-gaku, “study”). Coined by Nishi Amane in his 1874 百一新論 as a translation of English philosophy or Dutch filosofie. Nishi's kanji spelling 希哲學 (hirosohi) is literally calqued from Ancient Greek φιλοσοφία (philosophía, “pursuit of wisdom”, literally “love of knowledge”), apparently from the Chinese morphemes 希 (xī, “to long for”) and 哲 (zhé, “wisdom”), before he later settled with 哲學 (modernly spelt 哲学)."
      },
      {
        "quote": "Nishi also used the transcriptions ヒロソヒ, ヒロソヒー (hirosohī) and 斐鹵蘇比."
      }
    ],
    "examples": [
      {
        "id": 163787,
        "ja": "私の兄は哲学の権威だ。",
        "en": "My brother's an authority on philosophy.",
        "enId": 250723,
        "form": "哲学",
        "furigana": [
          ["私", "わたし"],
          ["の"],
          ["兄", "あに"],
          ["は"],

[
  {
    "date": "2009-04-01",
    "term": "高い",
    "kana": "たかい",
    "meaning": "tall, high; expensive",
    "level": "N5",
    "pos": ["adjective (keiyoushi)"],
    "priority": ["ichi1", "news1", "nf08"],
    "pitch": [2],
    "antonyms": [
      {
        "term": "低い"
      }
    ],
    "stratum": "wago",
    "processes": [],
    "headline": "高い comes from the Early Middle Japanese adjective 高し (takashi).",
    "morphemes": [],
    "sources": [
      {
        "quote": "From Early Middle Japanese adjective 高(たか)し (takashi), with the 終(しゅう)止(し)形(けい) (shūshikei, “predicative form”) ending in し (shi) first replaced with the 連(れん)体(たい)形(けい) (rentaikei, “attributive form”) ending in き (ki), and then with the medial /-k-/ falling out to result in an ending of い (i). From Old Japanese, from Proto-Japonic *taka."
      }
    ],
    "examples": [
      {
        "id": 218646,
        "ja": "これはあれよりも値段がたかい。",
        "en": "This is more expensive than that.",
        "enId": 55960,
        "form": "たかい",
        "furigana": [["これはあれよりも"], ["値段", "ねだん"], ["がたかい。"]]
      },
      {
        "id": 200065,
        "ja": "トムはそのたかい木に登ってみた。",
        "en": "Tom tried climbing the tall tree.",
        "enId": 37266,
        "form": "たかい",
        "furigana": [
          ["トムはそのたかい"],
          ["木", "き"],
          ["に"],
          ["登", "のぼ"],
          ["ってみた。"]
        ]
      }
    ],

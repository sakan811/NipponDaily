{
  "name": "nippondaily",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "HOST=127.0.0.1 node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "pnpm exec prettier . --write",
    "type-check": "tsc --noEmit",
    "check-qa": "pnpm lint && pnpm format && pnpm type-check && pnpm build && pnpm test:run"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@tavily/core": "^0.7.6",
    "@upstash/redis": "^1.38.2",
    "@upstash/vector": "^1.2.3",
    "marked": "^18.0.9",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

    "headline": "酔う took a long road: from Old Japanese wepu to jou, by way of classical 酔ふ.",
    "morphemes": [],
    "sources": [
      {
        "quote": "/wepu/ → /wefu/ → /jefu/ → */jewu/ → */jowu/ → /jou/"
      },
      {
        "quote": "Shift from classical verb 酔ふ (efu → eu), possibly parsed as jefu, itself from Old Japanese 酔ふ (wepu → wefu → eu)."
      },
      {
        "quote": "Compare the development of 葉 (efu → yō, “leaf”, on-yomi or Chinese-derived reading)."
      }
    ],

  {
    "date": "2023-06-06",
    "term": "お母さん",
    "kana": "おかあさん",
    "meaning": "mother (formal)",
    "level": "N5",
    "pos": ["noun (common) (futsuumeishi)"],
    "priority": ["ichi1", "news1", "nf05"],
    "register": ["honorific or respectful (sonkeigo) language"],
    "pitch": [2],
    "processes": ["compound", "derivation", "sound-change"],
    "headline": "“Mother” in two layers: a surface of “honorific, mother, honorific”, and under it the older o-kaka-sama.",
    "morphemes": [
      {
        "text": "お",
        "reading": "お",
        "meaning": "honorific prefix"
      },
      {
        "text": "母",
        "reading": "かあ",
        "meaning": "mother",
        "irregular": true
      },
      {
        "text": "さん",
        "reading": "さん",
        "meaning": "honorific suffix"
      }
    ],
    "sources": [
      {
        "quote": "As a surface analysis, this is a compound of 御 (o-, honorific prefix) + 母 (kā, “mother”) + さん (-san, honorific suffix)."
      },
      {
        "quote": "Historically, this represents a sound shift from older term o-kaka-sama, itself a compound of 御 (o-, honorific prefix) + 母 (kaka, “mother”) + 様 (-sama, honorific suffix)."
      },
      {
        "quote": "/okakasama/ → /okkasama/ → /okaːsama/"
      },
      {
        "quote": "/okakasama/ → /okkasama/ → /okaːsan/"
      },
      {
        "quote": "Attested in Osaka and Kyoto, with rare use in Edo (Tokyo), from the late Edo period, especially among upper-middle class households in Osaka."
      },
      {
        "quote": "Usage became widespread in the 20th century after the Ministry of Education adopted お父(とう)さん (otōsan, “father”) and お母(かあ)さん for use in 尋常小学読本 (Jinjō shōgaku dokuhon “Standard elementary school reader”, 1903)."
      }
    ],
    "examples": [
      {
        "id": 82605,
        "ja": "坊や、おかあさんは何処だい？",
        "en": "Where is your mother, boy?",
        "enId": 321111,
        "form": "おかあさん",
        "furigana": [
          ["坊", "ぼう"],
          ["や、おかあさんは"],
          ["何処", "どこ"],
          ["だい？"]
        ]
      },
      {

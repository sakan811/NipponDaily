 "でも": {
  "url": "https://en.wiktionary.org/wiki/%E3%81%A7%E3%82%82",
  "etymologies": [
   {
    "heading": "Etymology",
    "text": "で (de, conjunctive (\"て-form\") of copula だ/です) + も (mo, “even; too”).\nWhen でも follows a noun, で is the conjunctive or \"て-form\" of the copula だ/です. で can also appear in the conjunctive form of certain classes of verbs; in that case, でも can be analyzed as the conjunctive form of the verb + the inclusive particle も, and means \"even if\"; compare with the allomorph ても used for different classes of verbs.",
    "readings": []
   }
  ]
 },

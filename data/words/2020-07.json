    "headline": "Ohayō was originally 御 (o-) plus 早く (hayaku, “early”), from the adjective 早い (hayai).",
    "morphemes": [],
    "sources": [
      {
        "quote": "Originally a compound of 御 (o-, honorific prefix) + 早く (hayaku, “early”, adverb), from adjective 早い (hayai, “early”)."
      },
      {
        "quote": "Modern Japanese -i adjectives formerly ended in -ki for the attributive form. This medial /k/ dropped out during the Muromachi period, both for the attributive form (-ki becoming -i) and for the adverbial form (-ku becoming -u). However, the adverbial form reverted back to -ku thereafter for most words, with the -u ending persisting in certain everyday set expressions, such as arigatō, ohayō, or omedetō, and in hyper-formal speech."
      },
      {
        "quote": "/ohajaku/ → /ohajau/ → /ohajoː/"
      }
    ],
    "wiktionaryDump": "2026-09-02"

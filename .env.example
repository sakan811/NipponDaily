# The site's public origin, e.g. https://nippondaily.example — used for canonical
# and Open Graph URLs and the sitemap. Optional: without it, each request's own
# origin is used.
NUXT_PUBLIC_SITE_URL=""

# Build time only. 1 writes the page of every past day as a static file, 0 turns
# that off; unset, it is on for a Vercel deploy and off elsewhere.
PRERENDER_PAST_DAYS=""

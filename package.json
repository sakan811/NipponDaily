{
  "name": "nippondaily",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "HOST=127.0.0.1 node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "pnpm exec prettier . --write",
    "type-check": "tsc --noEmit",
    "check-qa": "pnpm lint && pnpm format && pnpm type-check && pnpm build && pnpm test:run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@upstash/redis": "^1.38.4",
    "kuromoji": "^0.1.2",
    "marked": "^18.0.12",
    "mcp-handler": "^2.1.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "wanakana": "^5.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "h3": "^1.15.11",
    "happy-dom": "^20.14.3",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}

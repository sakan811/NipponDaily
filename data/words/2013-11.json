    "processes": ["derivation", "unclear"],
    "morphemes": [],
    "sources": [
      {
        "quote": "Ultimate derivation currently unknown, with various resources listing no etymology. Theories include:"
      },
      {
        "quote": "* Perhaps related to interjection は (ha, “yes”), which first appears in the early 1600s."
      },
      {
        "quote": "* Alternatively, may perhaps from Sino-Japanese 拝 (hai), but this theory is not academically accepted."
      },
      {
        "quote": "First cited as a general shout in the early 1600s (compare English hey), with the affirmative yes sense first cited to 1774."
      }
    ],

  {
    "date": "2025-06-01",
    "term": "義理",
    "kana": "ぎり",
    "meaning": "debt of gratitude, obligation",
    "level": "N1",
    "pos": [
      "noun (common) (futsuumeishi)",
      "nouns which may take the genitive case particle 'no'"
    ],
    "priority": ["ichi1", "news1", "nf14"],
    "stratum": "kango",
    "processes": ["compound", "borrowing"],
    "headline": "Giri is from Middle Chinese 義理, which first meant “righteous principle” and narrowed in Japan during the Muromachi and Edo periods.",
    "morphemes": [
      {
        "text": "義",
        "reading": "ぎ",
        "meaning": "meaning",
        "glossSource": "kanjidic2"
      },
      {
        "text": "理",
        "reading": "り",
        "meaning": "reason",
        "glossSource": "kanjidic2"
      }
    ],
    "sources": [
      {
        "quote": "From Middle Chinese 義理 (MC ngjeH liX)."
      },
      {
        "quote": "Originally, in Middle Chinese and early Japanese attestations, the term carried a philosophical and textual meaning of “righteous principle”, “reason”, or “significance”. During the Muromachi and Edo periods, under the influence of a stratified feudal society, samurai ethics, and the merchant class, the concept underwent semantic narrowing in Japan. The “correct path” shifted to refer specifically to the reciprocal behavioral norms, social debts, and favors expected between individuals in a hierarchical community. This transformed the philosophical concept into a localized social contract and “burden of obligation”, famously contrasting with 人情 (ninjō, “human feeling”). This specialized sense developed entirely internally within Japan."
      }
    ],
    "examples": [
      {
        "id": 154177,
        "ja": "私は彼に義理を立てなければならない。",
        "en": "I have to do right by him.",
        "enId": 260366,
        "form": "義理",
        "furigana": [
          ["私", "わたし"],
          ["は"],
          ["彼", "かれ"],
          ["に"],
          ["義理", "ぎり"],
          ["を"],
          ["立", "た"],
          ["てなければならない。"]
        ]
      },
      {
        "id": 122354,
        "ja": "日本語の「義理」に相当する英語は見つからない。",
        "en": "We cannot find an English equivalent for the Japanese 'giri'.",
        "enId": 281649,
        "form": "義理",
        "furigana": [
          ["日本語の「"],
          ["義理", "ぎり"],
          ["」に"],
          ["相当", "そうとう"],
          ["する"],
          ["英語", "えいご"],
          ["は"],
          ["見", "み"],
          ["つからない。"]
        ]
      }
    ],

    "sources": [
      {
        "quote": "/fumite/ → /fũnde/ → /fude/"
      },
      {
        "quote": "Shift in pronunciation from fumite below, caused by a regular shift where medial み (mi) causes nasalization of the preceding vowel and voicing of the following consonant, with the nasalization reverting in some cases. Now the most common pronunciation in modern Japanese."
      }
    ],

    "processes": ["compound", "rendaku", "borrowing"],
    "headline": "Danna is from Middle Chinese 旦那 and 檀那, both used as transliterations of a Sanskrit word for “generosity, giving, donating”.",
    "morphemes": [
      {
        "text": "旦",
        "reading": "だん",
        "base": "たん",
        "meaning": "daybreak",
        "glossSource": "kanjidic2"
      },
      {
        "text": "那",
        "reading": "な",
        "meaning": "what?",
        "glossSource": "kanjidic2"
      }
    ],
    "sources": [
      {
        "quote": "From Middle Chinese 旦那 (MC tanH na), 檀那 (MC dan na), both used as transliterations of Sanskrit दान (dā́na, “generosity, giving, donating”). Ultimately cognate with English donate and donor, from Proto-Indo-European *déh₃nom."
      },
      {
        "quote": "Attested in Japanese sinophone sources since at least the 1000s and in vernacular Japanese sources since at least 1287."
      }
    ],
    "wiktionaryDump": "2026-09-02"

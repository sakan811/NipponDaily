  {
    "date": "2021-10-04",
    "term": "食う",
    "kana": "くう",
    "meaning": "(male) (vulg.) to eat",
    "level": "N3",
    "pos": ["Godan verb with 'u' ending", "transitive verb"],
    "stratum": "wago",
    "processes": ["sound-change"],
    "headline": "Kuu went from kupu through kuwu to kuu; the medial w vanishes but resurfaces in kuwanai and kuwareru.",
    "morphemes": [],
    "sources": [
      {
        "quote": "/kupu/ → */kuwu/ → /kuu/"
      },
      {
        "quote": "From Old Japanese. from Proto-Japonic *kup-."
      },
      {
        "quote": "The medial /w/ vanishes because Japanese does not have a /wu/ phoneme. It surfaces though in various conjugations, such as the negative form kuwanai or the passive form kuwareru."
      },
      {
        "quote": "Possibly cognate with 口(くち) (kuchi, “mouth”)."
      }
    ],
    "wiktionaryDump": "2026-09-02"
  },
